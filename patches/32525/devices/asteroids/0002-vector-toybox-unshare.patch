-        thread::sleep(Duration::from_millis(1000));
+        let vector_log_marker = if vector_requested {
+            wait_vector_root_daemon()?;
+            Some(mark_vector_verification_log()?)
+        } else {
+            thread::sleep(Duration::from_millis(1000));
