     if run_module_scripts {
+        let wait_for_vector = prepare_vector_service_stage()?;
         init_event::run_stage("service", false);
-        thread::sleep(Duration::from_millis(1000));
+        if wait_for_vector {
+            wait_vector_service_ready()?;
+        } else {
+            thread::sleep(Duration::from_millis(1000));
+        }
         restart_zygote_for_late_modules()?;
