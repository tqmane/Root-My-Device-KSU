+use std::path::Path;
@@ -21,0 +23,85 @@
+fn start_vector_toybox_compat_daemon() -> Result<()> {
+    const VECTOR_DIR: &str = "/data/adb/modules/zygisk_vector";
+    const VECTOR_SOCKET: &str = "/data/adb/lspd/.cli_sock";
+
+    let module_dir = Path::new(VECTOR_DIR);
+    if !module_dir.is_dir()
+        || module_dir.join("disable").exists()
+        || module_dir.join("remove").exists()
+    {
+        return Ok(());
+    }
+
+    let service = module_dir.join("service.sh");
+    let daemon = module_dir.join("daemon");
+    if !service.is_file() || !daemon.is_file() {
+        return Ok(());
+    }
+
+    let script = fs::read_to_string(&service)
+        .with_context(|| format!("failed to read {}", service.display()))?;
+    if !script.contains("unshare --propagation slave -m") {
+        return Ok(());
+    }
+
+    // A pathname alone is not a readiness signal for AF_UNIX sockets. Vector
+    // can leave .cli_sock behind when its daemon dies, including across our
+    // late-load experiments. Only treat the socket as ready when something is
+    // actually listening on it; otherwise remove the stale node before start.
+    if std::os::unix::net::UnixStream::connect(VECTOR_SOCKET).is_ok() {
+        info!("Asteroids late-load: Vector CLI socket already accepting connections");
+        return Ok(());
+    }
+    if Path::new(VECTOR_SOCKET).exists() {
+        warn!("Asteroids late-load: removing stale Vector CLI socket");
+        fs::remove_file(VECTOR_SOCKET)
+            .context("failed to remove stale Vector CLI socket")?;
+    }
+
+    // Vector's current service.sh uses util-linux syntax:
+    //   unshare --propagation slave -m ...
+    // Android's toybox unshare accepts -m but not --propagation. Reproduce
+    // the same namespace setup with toybox-compatible primitives instead of
+    // modifying the installed module. The normal service stage still runs;
+    // its unsupported unshare invocation may log an error, but this daemon is
+    // already alive before the replacement zygote/system_server is created.
+    info!("Asteroids late-load: starting Vector with toybox-compatible unshare");
+    let daemon_path = daemon.to_string_lossy().into_owned();
+    let mut child = Command::new("/system/bin/unshare")
+        .arg("-m")
+        .arg("/system/bin/sh")
+        .arg("-c")
+        .arg("mount -o rslave none / || exit 1; exec \"$1\" --system-server-max-retry=3")
+        .arg("sh")
+        .arg(&daemon_path)
+        .spawn()
+        .context("failed to start Vector compatibility daemon")?;
+
+    // Vector's launcher may exit 0 after successfully spawning the real
+    // app_process/RuntimeInit daemon. A successful launcher exit is therefore
+    // not a daemon failure. Keep waiting for the live AF_UNIX listener and only
+    // treat a non-zero launcher status as an immediate startup failure.
+    let mut launcher_reaped = false;
+    for _ in 0..50 {
+        if std::os::unix::net::UnixStream::connect(VECTOR_SOCKET).is_ok() {
+            info!("Asteroids late-load: Vector compatibility daemon ready");
+            return Ok(());
+        }
+        if !launcher_reaped {
+            if let Some(status) = child
+                .try_wait()
+                .context("failed to poll Vector compatibility launcher")?
+            {
+                if !status.success() {
+                    anyhow::bail!("Vector compatibility launcher failed: {status}");
+                }
+                info!("Asteroids late-load: Vector compatibility launcher exited successfully; waiting for daemon socket");
+                launcher_reaped = true;
+            }
+        }
+        thread::sleep(Duration::from_millis(100));
+    }
+
+    warn!("Asteroids late-load: Vector CLI socket not ready after compatibility launch");
+    Ok(())
+}
@@ -260,6 +329,7 @@
     // already running. Give non-blocking service scripts a short head start,
     // then recreate the zygote-start boundary.
     if run_module_scripts {
+        start_vector_toybox_compat_daemon()?;
         init_event::run_stage("service", false);
         thread::sleep(Duration::from_millis(1000));
         restart_zygote_for_late_modules()?;
