diff --git a/userspace/ksud/src/late_load.rs b/userspace/ksud/src/late_load.rs
--- a/userspace/ksud/src/late_load.rs
+++ b/userspace/ksud/src/late_load.rs
@@ -5,0 +6,1 @@
+use std::path::Path;
@@ -21,0 +23,199 @@
+const VECTOR_DIR: &str = "/data/adb/modules/zygisk_vector";
+const VECTOR_SOCKET: &str = "/data/adb/lspd/.cli_sock";
+
+fn vector_module_enabled() -> bool {
+    let module_dir = Path::new(VECTOR_DIR);
+    module_dir.is_dir()
+        && !module_dir.join("disable").exists()
+        && !module_dir.join("remove").exists()
+        && module_dir.join("service.sh").is_file()
+        && module_dir.join("daemon").is_file()
+        && module_dir.join("action.sh").is_file()
+}
+
+fn patch_vector_service_for_android_tools() -> Result<()> {
+    let service_path = Path::new(VECTOR_DIR).join("service.sh");
+    let service = fs::read_to_string(&service_path)
+        .context("failed to read Vector service.sh")?;
+
+    const MARKER: &str = "RMN_ASTEROIDS_VECTOR_SERVICE_V2";
+    if service.contains(MARKER) {
+        info!("Asteroids late-load: Vector service launcher already audited");
+        return Ok(());
+    }
+
+    // Preserve the installed vendor script once. Replace every older RMN
+    // variant: the failed variants used util-linux-only --propagation syntax,
+    // bare BusyBox applets, nested su, or an extra background process.
+    let backup_path = Path::new(VECTOR_DIR).join("service.sh.rmn-stock");
+    if !backup_path.exists() {
+        fs::copy(&service_path, &backup_path)
+            .context("failed to back up Vector service.sh")?;
+    }
+
+    const AUDITED_SERVICE: &str = r#"#!/system/bin/sh
+# RMN_ASTEROIDS_VECTOR_SERVICE_V2
+MODDIR="${0%/*}"
+cd "$MODDIR" || exit 1
+
+# Vector's stock script requests util-linux `--propagation slave`. Android's
+# /system/bin/unshare supports a mount namespace but not that option, so set
+# recursive-slave propagation from inside the new namespace. Use absolute
+# Android tools: KernelSU module scripts otherwise run in a BusyBox ash
+# environment where bare applet resolution is not equivalent.
+#
+# There is deliberately no trailing `&`. KernelSU's service stage is already
+# non-blocking; the service-stage child must stay attached to the launcher
+# until Vector has replaced it with its real daemon process.
+exec /system/bin/unshare -m /system/bin/sh -c '
+    /system/bin/mount -o rslave none / || exit 1
+    DAEMON="$1"
+    shift
+    exec "$DAEMON" --system-server-max-retry=3 "$@"
+' sh "$MODDIR/daemon" "$@"
+"#;
+
+    fs::write(&service_path, AUDITED_SERVICE)
+        .context("failed to install audited Vector service.sh")?;
+    let mut perms = fs::metadata(&service_path)?.permissions();
+    perms.set_mode(0o755);
+    fs::set_permissions(&service_path, perms)?;
+    info!("Asteroids late-load: Vector service launcher installed with absolute Android tools");
+    Ok(())
+}
+
+fn vector_socket_registered() -> bool {
+    fs::read_to_string("/proc/net/unix")
+        .map(|table| table.lines().any(|line| line.contains(VECTOR_SOCKET)))
+        .unwrap_or(false)
+}
+
+fn stop_stale_vector_launcher() {
+    let Ok(entries) = fs::read_dir("/proc") else {
+        return;
+    };
+    for entry in entries.flatten() {
+        let Some(pid) = entry.file_name().to_str().and_then(|s| s.parse::<u32>().ok()) else {
+            continue;
+        };
+        let cmdline = fs::read(entry.path().join("cmdline")).unwrap_or_default();
+        if !String::from_utf8_lossy(&cmdline)
+            .contains("/data/adb/modules/zygisk_vector/daemon")
+        {
+            continue;
+        }
+        warn!("Asteroids late-load: stopping stale Vector launcher pid={pid}");
+        match Command::new("/system/bin/kill")
+            .args(["-9", &pid.to_string()])
+            .status()
+        {
+            Ok(status) if status.success() => {}
+            Ok(status) => warn!("Asteroids late-load: kill pid={pid} exited {status}"),
+            Err(err) => warn!("Asteroids late-load: kill pid={pid} failed: {err}"),
+        }
+    }
+}
+
+fn prepare_vector_service_stage() -> Result<bool> {
+    if !vector_module_enabled() {
+        info!("Asteroids late-load: Vector lifecycle skipped: module unavailable or disabled");
+        return Ok(false);
+    }
+    patch_vector_service_for_android_tools()?;
+
+    // A stale filesystem socket is not readiness. /proc/net/unix proves that
+    // a live process has the pathname registered in the kernel.
+    if vector_socket_registered() {
+        info!("Asteroids late-load: existing Vector root daemon socket is registered");
+        return Ok(true);
+    }
+    stop_stale_vector_launcher();
+    if Path::new(VECTOR_SOCKET).exists() {
+        warn!("Asteroids late-load: removing stale Vector CLI socket inode");
+        fs::remove_file(VECTOR_SOCKET)
+            .context("failed to remove stale Vector CLI socket inode")?;
+    }
+    info!("Asteroids late-load: Vector prepared for the single native service-stage launch");
+    Ok(true)
+}
+
+fn wait_vector_root_daemon() -> Result<()> {
+    for _ in 0..150 {
+        if vector_socket_registered() {
+            info!("Asteroids late-load: Vector root daemon socket registered");
+            return Ok(());
+        }
+        thread::sleep(Duration::from_millis(100));
+    }
+    anyhow::bail!(
+        "Vector service stage did not register {} within 15 seconds (inode_exists={})",
+        VECTOR_SOCKET,
+        Path::new(VECTOR_SOCKET).exists()
+    )
+}
+
+fn mark_vector_verification_log() -> Result<String> {
+    let marker = format!("RMN_VECTOR_AUDIT_{}", std::process::id());
+    let status = Command::new("/system/bin/log")
+        .args(["-t", "RMNVectorAudit", &marker])
+        .status()
+        .context("failed to write Vector verification log marker")?;
+    anyhow::ensure!(status.success(), "log marker command exited {status}");
+    Ok(marker)
+}
+
+fn wait_activity_manager_ready() -> Result<()> {
+    for _ in 0..40 {
+        let ready = Command::new("/system/bin/cmd")
+            .args(["activity", "get-current-user"])
+            .status()
+            .map(|status| status.success())
+            .unwrap_or(false);
+        if ready {
+            return Ok(());
+        }
+        thread::sleep(Duration::from_millis(250));
+    }
+    anyhow::bail!("replacement ActivityManager did not become command-ready within 10 seconds")
+}
+
+fn verify_vector_system_server_bridge(marker: &str) -> Result<()> {
+    wait_activity_manager_ready()?;
+    let action_path = Path::new(VECTOR_DIR).join("action.sh");
+    let status = Command::new("/system/bin/sh")
+        .arg(&action_path)
+        .status()
+        .context("failed to invoke Vector module action")?;
+    anyhow::ensure!(status.success(), "Vector action.sh exited {status}");
+
+    let mut saw_get_binder = false;
+    let mut saw_parasitic_manager = false;
+    let mut saw_serial_failure = false;
+    for _ in 0..40 {
+        let output = Command::new("/system/bin/logcat")
+            .args(["-d", "-v", "brief", "-t", "3000"])
+            .output()
+            .context("failed to read logcat for Vector bridge verification")?;
+        let log = String::from_utf8_lossy(&output.stdout);
+        let Some(marker_pos) = log.rfind(marker) else {
+            thread::sleep(Duration::from_millis(250));
+            continue;
+        };
+        let current = &log[marker_pos..];
+        saw_get_binder |= current.contains("VectorZygiskBridge: onTransact: action=GET_BINDER");
+        saw_parasitic_manager |= current.contains("ParasiticHooker:");
+        saw_serial_failure |= current.contains("Failed to get system server binder via serial");
+        if saw_get_binder && saw_parasitic_manager {
+            info!("Asteroids late-load: Vector system_server bridge and parasitic manager verified");
+            return Ok(());
+        }
+        thread::sleep(Duration::from_millis(250));
+    }
+
+    anyhow::bail!(
+        "Vector end-to-end verification failed (GET_BINDER={}, ParasiticHooker={}, serial_failure={})",
+        saw_get_binder,
+        saw_parasitic_manager,
+        saw_serial_failure
+    )
+}
