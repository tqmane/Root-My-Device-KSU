+        .stdout(Stdio::from(stdout))
+        .stderr(Stdio::from(stderr))
+        .spawn()
+    {
+        Ok(child) => info!(
+            "Asteroids late-load: soft-reboot module watchdog started pid={}",
+            child.id()
