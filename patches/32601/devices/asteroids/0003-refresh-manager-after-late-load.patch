+    let component = format!("{package_name}/me.weishu.kernelsu.ui.MainActivity");
+    match Command::new("/system/bin/am")
+        .args(["start", "-n", &component])
+        .status()
+    {
+        Ok(status) if status.success() => {
+            info!("Asteroids late-load: KernelSU Manager restarted after late-load");
+        }
+        Ok(status) => warn!("Asteroids late-load: Manager start exited {status}; continuing"),
+        Err(error) => warn!("Asteroids late-load: Manager start failed: {error}; continuing"),
+    }
+}
